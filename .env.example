RELAYMESH_HOST=127.0.0.1
RELAYMESH_PORT=4317
RELAYMESH_DATA_DIR=./data
RELAYMESH_HEARTBEAT_TIMEOUT_MS=30000
RELAYMESH_LEASE_SWEEP_MS=5000
RELAYMESH_ROLE_RESERVATION_MS=900000
# Optional: canonical HTTPS origin advertised by the A2A Agent Card
# RELAYMESH_PUBLIC_URL=https://relaymesh.example.com
# Optional: set a stable admin token instead of using data/admin-token.txt
# RELAYMESH_ADMIN_TOKEN=replace-with-a-long-random-token
