{
  "name": "relaymesh",
  "version": "0.5.0",
  "private": false,
  "description": "Durable coordination runtime for heterogeneous AI agent sessions.",
  "license": "MIT",
  "author": "Rayha33",
  "homepage": "https://github.com/Rayha33/relaymesh#readme",
  "bugs": {
    "url": "https://github.com/Rayha33/relaymesh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rayha33/relaymesh.git"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "mcp",
    "a2a",
    "coordination",
    "crash-recovery",
    "llm"
  ],
  "type": "module",
  "main": "./dist/server/src/sdk/index.js",
  "types": "./dist/server/src/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/src/sdk/index.d.ts",
      "import": "./dist/server/src/sdk/index.js"
    },
    "./sdk": {
      "types": "./dist/server/src/sdk/index.d.ts",
      "import": "./dist/server/src/sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "relaymesh": "dist/server/src/cli/index.js",
    "relaymesh-mcp": "dist/server/src/mcp/index.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    ".env.example",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "scripts/prepare.mjs"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run clean && npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json && node scripts/build-mcp.mjs",
    "build:web": "vite build",
    "clean": "node scripts/clean.mjs",
    "start": "node dist/server/src/server/index.js",
    "cli": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "demo:seed": "tsx src/scripts/seed-demo.ts",
    "demo": "npm run demo:seed && npm run dev",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/verify-package.mjs",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "jose": "^6.2.9",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
